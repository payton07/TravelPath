rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // PDFs generated by Cloud Functions (Admin SDK bypasses these rules).
    // Authenticated users can download their own itinerary PDFs.
    match /pdfs/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // writes come exclusively from Cloud Functions (Admin SDK)
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
