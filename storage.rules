rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // PDFs generated by Cloud Functions (Admin SDK bypasses these rules).
    // Public read is safe: filenames contain a UUID that makes URLs unguessable.
    // All writes are blocked from the client; only Cloud Functions (Admin SDK) write here.
    match /pdfs/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
