<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg">

    <!-- Swipeable route cards (behind top bar) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerRoutes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="96dp"
        android:paddingBottom="72dp"
        android:paddingHorizontal="20dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:visibility="gone" />

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="52dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="7dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/color_ink"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="Back" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvPageCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 / 3"
            android:textColor="@color/color_ink_soft"
            android:textSize="13sp"
            android:fontFamily="@font/geist"
            android:letterSpacing="0.04" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Balance spacer matching back button width -->
        <View
            android:layout_width="34dp"
            android:layout_height="34dp" />

    </LinearLayout>

    <!-- Loading spinner -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/color_accent"
        android:visibility="gone" />

    <!-- Empty / generating state -->
    <TextView
        android:id="@+id/tvEmptyRoutes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/generating_routes"
        android:textColor="@color/color_ink_soft"
        android:textSize="15sp"
        android:fontFamily="@font/geist"
        android:visibility="visible" />

    <!-- Page indicator dots -->
    <LinearLayout
        android:id="@+id/pageIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="18dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone" />

</FrameLayout>
