<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:orientation="horizontal">

    <!-- Left column: circle + connecting line -->
    <LinearLayout
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvStepNumber"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_timeline_marker"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/color_ink"
            android:textStyle="bold"
            android:textSize="14sp"
            android:fontFamily="@font/fraunces" />

        <!-- Connector line -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/color_line"
            android:minHeight="24dp" />

    </LinearLayout>

    <!-- Step card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/color_surface"
        app:strokeColor="@color/color_line"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Optional place photo -->
            <ImageView
                android:id="@+id/ivStepPhoto"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvStepName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nom du lieu"
                    android:textColor="@color/color_ink"
                    android:textSize="15sp"
                    android:fontFamily="@font/fraunces"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStepTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="10:00 - 12:00"
                    android:textColor="@color/color_ink_soft"
                    android:textSize="12sp"
                    android:fontFamily="@font/geist" />

                <TextView
                    android:id="@+id/tvOpeningHours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/open"
                    android:textColor="@color/color_accent"
                    android:textSize="11sp"
                    android:fontFamily="@font/geist"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
