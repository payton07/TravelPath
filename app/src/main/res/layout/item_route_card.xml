<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/color_surface"
    app:strokeColor="@color/color_line"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Thumbnail -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp">

            <ImageView
                android:id="@+id/ivRouteThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_travel_mode" />

            <!-- Like / save button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLike"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@android:drawable/btn_star_big_off"
                app:iconTint="@color/color_ink"
                app:iconSize="18dp"
                app:iconPadding="0dp"
                app:backgroundTint="@color/color_surface"
                app:strokeColor="@color/color_line"
                app:strokeWidth="1dp"
                app:cornerRadius="18dp" />
        </FrameLayout>

        <!-- Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tvRouteName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Route Name"
                android:textColor="@color/color_ink"
                android:textSize="18sp"
                android:fontFamily="@font/fraunces"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Stats -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvCost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20€"
                    android:textColor="@color/color_accent"
                    android:textSize="13sp"
                    android:fontFamily="@font/geist"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:text="·"
                    android:textColor="@color/color_line"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5h"
                    android:textColor="@color/color_ink_soft"
                    android:textSize="13sp"
                    android:fontFamily="@font/geist" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:text="·"
                    android:textColor="@color/color_line"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvEffort"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Moderate"
                    android:textColor="@color/color_ink_soft"
                    android:textSize="13sp"
                    android:fontFamily="@font/geist" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvWeather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="SUNNY"
                android:textColor="@color/color_ink_soft"
                android:textSize="11sp"
                android:fontFamily="@font/geist"
                android:textAllCaps="true"
                android:letterSpacing="0.06" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectRoute"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:text="@string/select_route"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:letterSpacing="0.01"
                android:textColor="@color/color_surface"
                android:fontFamily="@font/geist"
                app:cornerRadius="24dp"
                app:backgroundTint="@color/color_ink" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
