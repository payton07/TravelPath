<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg">

    <!-- Collapsing photo header -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:contentScrim="@color/color_bg"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:titleCollapseMode="fade">

            <ImageView
                android:id="@+id/ivPoiPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_travel_mode"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.6" />

            <androidx.appcompat.widget.Toolbar
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:paddingTop="16dp"
                app:contentInsetStart="0dp"
                app:layout_collapseMode="pin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="20dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/btnBack"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:padding="7dp"
                        android:src="@drawable/ic_arrow_back"
                        android:tint="@color/color_ink"
                        android:background="@drawable/bg_circle_button"
                        android:contentDescription="@string/back" />
                </LinearLayout>
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="32dp"
        android:background="@color/color_bg"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="28dp">

            <!-- Name -->
            <TextView
                android:id="@+id/tvPoiName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/color_ink"
                android:textSize="26sp"
                android:fontFamily="@font/fraunces"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.1" />

            <!-- Category -->
            <TextView
                android:id="@+id/tvPoiCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/color_ink_soft"
                android:textSize="13sp"
                android:fontFamily="@font/geist"
                android:textAllCaps="true"
                android:letterSpacing="0.05" />

            <!-- Rating + open status row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvPoiRating"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/color_ink"
                    android:textSize="15sp"
                    android:fontFamily="@font/fraunces"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPoiOpenStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_city_pill"
                    android:textSize="12sp"
                    android:fontFamily="@font/geist"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="@color/color_line" />

            <!-- Opening hours section -->
            <LinearLayout
                android:id="@+id/layoutHours"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HORAIRES"
                    android:textColor="@color/color_ink_soft"
                    android:textSize="10sp"
                    android:fontFamily="@font/geist"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08" />

                <LinearLayout
                    android:id="@+id/hoursContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:background="@color/color_line" />
            </LinearLayout>

            <!-- Estimated duration -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="DURÉE ESTIMÉE"
                    android:textColor="@color/color_ink_soft"
                    android:textSize="10sp"
                    android:fontFamily="@font/geist"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvPoiDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_ink"
                    android:textSize="15sp"
                    android:fontFamily="@font/fraunces"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Crowd level row -->
            <LinearLayout
                android:id="@+id/layoutCrowdLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="AFFLUENCE"
                    android:textColor="@color/color_ink_soft"
                    android:textSize="10sp"
                    android:fontFamily="@font/geist"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvPoiCrowdLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:background="@drawable/bg_city_pill"
                    android:textSize="12sp"
                    android:fontFamily="@font/geist"
                    android:textStyle="bold"
                    android:textColor="@color/color_ink" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="@color/color_line" />

            <!-- Address section -->
            <LinearLayout
                android:id="@+id/layoutAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_address"
                    android:textColor="@color/color_ink_soft"
                    android:textSize="10sp"
                    android:fontFamily="@font/geist"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvPoiAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/color_ink"
                    android:textSize="14sp"
                    android:fontFamily="@font/geist" />
            </LinearLayout>

            <!-- Cost row -->
            <LinearLayout
                android:id="@+id/layoutCost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_cost_detail"
                    android:textColor="@color/color_ink_soft"
                    android:textSize="10sp"
                    android:fontFamily="@font/geist"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvPoiCost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_ink"
                    android:textSize="15sp"
                    android:fontFamily="@font/fraunces"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Best time row -->
            <LinearLayout
                android:id="@+id/layoutBestTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_best_time"
                    android:textColor="@color/color_ink_soft"
                    android:textSize="10sp"
                    android:fontFamily="@font/geist"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvPoiBestTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_ink"
                    android:textSize="15sp"
                    android:fontFamily="@font/fraunces"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Get directions button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGetDirections"
                style="@style/Widget.TravelPath.Button.Accent"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:text="@string/get_directions"
                android:textSize="15sp"
                android:fontFamily="@font/geist"
                android:textStyle="bold"
                app:cornerRadius="28dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
