<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.gms.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top overlay : back + step counter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="7dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/color_ink"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="@string/back"
            android:elevation="4dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Step badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            android:background="@drawable/bg_city_pill"
            android:gravity="center_vertical"
            android:elevation="4dp">

            <TextView
                android:id="@+id/tvNavStep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_ink"
                android:textSize="12sp"
                android:fontFamily="@font/geist"
                android:textStyle="bold"
                android:letterSpacing="0.04" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom navigation panel -->
    <LinearLayout
        android:id="@+id/navPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_nav_panel"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="36dp"
        android:elevation="12dp">

        <!-- POI name -->
        <TextView
            android:id="@+id/tvNavPoiName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/color_ink"
            android:textSize="22sp"
            android:fontFamily="@font/fraunces"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Category + open status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvNavPoiCategory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/color_ink_soft"
                android:textSize="12sp"
                android:fontFamily="@font/geist"
                android:textAllCaps="true"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvNavOpenStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:fontFamily="@font/geist"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:background="@color/color_line" />

        <!-- Navigation buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavPrev"
                style="@style/Widget.TravelPath.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="@string/nav_prev"
                android:fontFamily="@font/geist"
                android:textStyle="bold"
                app:cornerRadius="26dp" />

            <View
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavNext"
                style="@style/Widget.TravelPath.Button.Accent"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="2"
                android:text="@string/nav_next"
                android:fontFamily="@font/geist"
                android:textStyle="bold"
                app:cornerRadius="26dp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
