<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.TravelPath" parent="Theme.Material3.Light.NoActionBar">

        <!-- Default font: Geist (downloadable), system sans-serif fallback -->
        <item name="android:fontFamily">@font/geist</item>
        <item name="fontFamily">@font/geist</item>

        <!-- ── Color roles ──────────────────────────────────────────── -->
        <item name="colorPrimary">@color/color_accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/color_blush</item>
        <item name="colorOnPrimaryContainer">@color/color_ink</item>

        <item name="colorSecondary">@color/color_ink_soft</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/color_bg</item>
        <item name="colorOnSecondaryContainer">@color/color_ink</item>

        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_ink</item>
        <item name="colorSurfaceVariant">@color/color_bg</item>
        <item name="colorOnSurfaceVariant">@color/color_ink_soft</item>

        <item name="colorError">@color/status_error</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorErrorContainer">@color/status_error_bg</item>

        <item name="colorOutline">@color/color_line</item>
        <item name="colorOutlineVariant">@color/color_line</item>

        <!-- ── Window — light ─────────────────────────────────────── -->
        <item name="android:windowBackground">@color/color_bg</item>
        <item name="android:statusBarColor">@color/color_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:navigationBarColor">@color/color_bg</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <!-- ── Shapes ──────────────────────────────────────────────── -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeSmall</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeMedium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeLarge</item>

        <!-- ── Component defaults ─────────────────────────────────── -->
        <item name="materialCardViewStyle">@style/Widget.TravelPath.CardView</item>
        <item name="bottomNavigationStyle">@style/Widget.TravelPath.BottomNavigation</item>

    </style>

    <style name="Theme.TravelPath" parent="Base.Theme.TravelPath" />

    <!-- ═══════════════════════════════════════════════════════════════
         SHAPE SYSTEM
         ═══════════════════════════════════════════════════════════════ -->

    <style name="ShapeSmall" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeMedium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeLarge" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════
         COMPONENT OVERRIDES
         ═══════════════════════════════════════════════════════════════ -->

    <style name="Widget.TravelPath.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/color_surface</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/color_line</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.TravelPath.CardView.Hero" parent="Widget.TravelPath.CardView">
        <item name="cardCornerRadius">28dp</item>
        <item name="cardElevation">4dp</item>
    </style>

    <style name="Widget.TravelPath.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/color_bg</item>
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <item name="itemPaddingTop">8dp</item>
        <item name="itemPaddingBottom">8dp</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════
         TEXT APPEARANCES
         Display/Headline → Fraunces (editorial serif)
         Title/Body/Label → Geist  (clean UI sans)
         ═══════════════════════════════════════════════════════════════ -->

    <style name="TextAppearance.TravelPath.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">@font/fraunces</item>
        <item name="android:textSize">36sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/color_ink</item>
    </style>

    <style name="TextAppearance.TravelPath.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/fraunces</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/color_ink</item>
    </style>

    <style name="TextAppearance.TravelPath.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/fraunces</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/color_ink</item>
    </style>

    <style name="TextAppearance.TravelPath.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/geist</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/color_ink</item>
    </style>

    <style name="TextAppearance.TravelPath.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/geist</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/color_ink</item>
    </style>

    <style name="TextAppearance.TravelPath.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/geist</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/color_ink_soft</item>
    </style>

    <style name="TextAppearance.TravelPath.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/geist</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.10</item>
        <item name="android:textColor">@color/color_ink_soft</item>
    </style>

    <!-- Stop number / stat value in serif -->
    <style name="TextAppearance.TravelPath.StatValue" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/fraunces</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/color_ink</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════
         BUTTON STYLES
         ═══════════════════════════════════════════════════════════════ -->

    <!-- Primary: black pill, white text -->
    <style name="Widget.TravelPath.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/color_ink</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/geist</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="cornerRadius">27dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="rippleColor">@color/color_ink_soft</item>
    </style>

    <!-- Secondary: outline, ink text -->
    <style name="Widget.TravelPath.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/color_line</item>
        <item name="android:textColor">@color/color_ink</item>
        <item name="android:fontFamily">@font/geist</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">27dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <!-- Accent: tomato CTA -->
    <style name="Widget.TravelPath.Button.Accent" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/color_accent</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/geist</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">27dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="rippleColor">@color/color_accent_pressed</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════
         MODE BADGE CHIPS
         ═══════════════════════════════════════════════════════════════ -->

    <style name="Widget.TravelPath.Chip.Economy" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/mode_economy_bg</item>
        <item name="android:textColor">@color/mode_economy_text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">@font/geist</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="Widget.TravelPath.Chip.Balanced" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/mode_balanced_bg</item>
        <item name="android:textColor">@color/mode_balanced_text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">@font/geist</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="Widget.TravelPath.Chip.Comfort" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/mode_comfort_bg</item>
        <item name="android:textColor">@color/mode_comfort_text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">@font/geist</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

</resources>
