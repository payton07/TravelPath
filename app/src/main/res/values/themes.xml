<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.TravelPath" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Default font: Plus Jakarta Sans (local TTF — no GMS dependency) -->
        <item name="android:fontFamily">@font/plus_jakarta</item>
        <item name="fontFamily">@font/plus_jakarta</item>

        <!-- ── Color roles ──────────────────────────────────────────── -->
        <item name="colorPrimary">@color/gold</item>
        <item name="colorOnPrimary">@color/gold_text_on</item>
        <item name="colorPrimaryContainer">@color/bg_featured</item>
        <item name="colorOnPrimaryContainer">@color/gold</item>

        <item name="colorSecondary">@color/gold_dim</item>
        <item name="colorOnSecondary">@color/gold_text_on</item>
        <item name="colorSecondaryContainer">@color/bg_featured</item>
        <item name="colorOnSecondaryContainer">@color/text_cream</item>

        <item name="colorSurface">@color/bg_deep</item>
        <item name="colorOnSurface">@color/text_cream</item>
        <item name="colorSurfaceVariant">@color/bg_surface</item>
        <item name="colorOnSurfaceVariant">@color/text_muted</item>

        <item name="colorError">@color/status_error</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorErrorContainer">@color/status_error_bg</item>

        <item name="colorOutline">@color/border_default</item>
        <item name="colorOutlineVariant">@color/border_gold</item>

        <!-- ── Window — always dark ────────────────────────────────── -->
        <item name="android:windowBackground">@color/bg_deep</item>
        <item name="android:statusBarColor">@color/bg_frame</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:navigationBarColor">@color/bg_frame</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>

        <!-- ── Shapes ──────────────────────────────────────────────── -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeSmall</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeMedium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeLarge</item>

        <!-- ── Component defaults ─────────────────────────────────── -->
        <item name="materialCardViewStyle">@style/Widget.TravelPath.CardView</item>
        <item name="bottomNavigationStyle">@style/Widget.TravelPath.BottomNavigation</item>

    </style>

    <style name="Theme.TravelPath" parent="Base.Theme.TravelPath" />

    <!-- ═══════════════════════════════════════════════════════════════
         SHAPE SYSTEM
         ═══════════════════════════════════════════════════════════════ -->

    <style name="ShapeSmall" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeMedium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeLarge" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════
         COMPONENT OVERRIDES
         ═══════════════════════════════════════════════════════════════ -->

    <style name="Widget.TravelPath.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/bg_surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/border_default</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.TravelPath.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/bg_frame</item>
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <item name="itemPaddingTop">8dp</item>
        <item name="itemPaddingBottom">8dp</item>
        <item name="elevation">8dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════
         TEXT APPEARANCES
         Display/Headline  → Playfair Display  (editorial serif)
         Title/Body/Label  → DM Mono           (precision mono)
         ═══════════════════════════════════════════════════════════════ -->

    <style name="TextAppearance.TravelPath.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/text_cream</item>
    </style>

    <style name="TextAppearance.TravelPath.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_cream</item>
    </style>

    <style name="TextAppearance.TravelPath.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_cream</item>
    </style>

    <style name="TextAppearance.TravelPath.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_cream</item>
    </style>

    <style name="TextAppearance.TravelPath.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_cream</item>
    </style>

    <style name="TextAppearance.TravelPath.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="TextAppearance.TravelPath.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <!-- ── Gold stat value ──────────────────────────────────────────── -->
    <style name="TextAppearance.TravelPath.StatValue" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/gold</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════
         BUTTON STYLES
         ═══════════════════════════════════════════════════════════════ -->

    <style name="Widget.TravelPath.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/gold</item>
        <item name="android:textColor">@color/gold_text_on</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="rippleColor">@color/gold_dim</item>
    </style>

    <style name="Widget.TravelPath.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/gold</item>
        <item name="android:textColor">@color/gold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════
         MODE BADGE CHIPS
         ═══════════════════════════════════════════════════════════════ -->

    <style name="Widget.TravelPath.Chip.Economy" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/mode_economy_bg</item>
        <item name="android:textColor">@color/mode_economy_text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="Widget.TravelPath.Chip.Balanced" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/mode_balanced_bg</item>
        <item name="android:textColor">@color/mode_balanced_text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="Widget.TravelPath.Chip.Comfort" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/mode_comfort_bg</item>
        <item name="android:textColor">@color/mode_comfort_text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

</resources>
