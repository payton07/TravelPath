<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ═══════════════════════════════════════════════════════════════
         BASE
         ═══════════════════════════════════════════════════════════════ -->
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <color name="transparent">#00000000</color>

    <!-- ═══════════════════════════════════════════════════════════════
         BACKGROUND HIERARCHY  (dark warm editorial)
         Extracted from: .root bg, .frame bg, card bg, featured card bg
         ═══════════════════════════════════════════════════════════════ -->
    <color name="bg_deep">#111110</color>         <!-- main app background -->
    <color name="bg_frame">#0D0D0B</color>        <!-- deepest — frame / bottom bar -->
    <color name="bg_surface">#1A1A18</color>      <!-- cards, inputs, route options -->
    <color name="bg_featured">#1E1C12</color>     <!-- active/featured — golden tint -->
    <color name="bg_meta">#141412</color>         <!-- meta pill backgrounds -->

    <!-- Legacy aliases so existing layouts don't break -->
    <color name="bg_main">@color/bg_deep</color>
    <color name="bg_primary">@color/bg_deep</color>
    <color name="card_bg">@color/bg_surface</color>

    <!-- ═══════════════════════════════════════════════════════════════
         BORDERS
         ═══════════════════════════════════════════════════════════════ -->
    <color name="border_default">#2A2A22</color>  <!-- subtle warm dark border -->
    <color name="border_gold">#3A3520</color>     <!-- active / featured border -->

    <!-- Legacy alias -->
    <color name="border_color">@color/border_default</color>

    <!-- ═══════════════════════════════════════════════════════════════
         GOLD ACCENT  — the ONLY color in this palette
         Extracted from: #C8B87A used on CTAs, active chips, stats, timeline
         ═══════════════════════════════════════════════════════════════ -->
    <color name="gold">#C8B87A</color>            <!-- primary accent -->
    <color name="gold_dim">#8A7A52</color>        <!-- pressed / secondary gold -->
    <color name="gold_text_on">#0D0D0B</color>    <!-- text on gold bg (buttons) -->

    <!-- Legacy brand aliases -->
    <color name="brand_primary">@color/gold</color>
    <color name="brand_primary_dark">@color/gold_dim</color>
    <color name="brand_primary_light">#3A3520</color>
    <color name="brand_accent">@color/gold</color>
    <color name="brand_accent_light">@color/bg_featured</color>
    <color name="emerald_primary">@color/gold</color>
    <color name="emerald_accent">@color/gold</color>
    <color name="emerald_light">@color/bg_featured</color>

    <!-- Surface system aliases (used in upgraded themes.xml) -->
    <color name="surface_0">@color/bg_frame</color>
    <color name="surface_1">@color/bg_deep</color>
    <color name="surface_2">@color/bg_surface</color>
    <color name="surface_3">@color/bg_featured</color>

    <!-- ═══════════════════════════════════════════════════════════════
         TYPOGRAPHY
         Extracted from: .muted #6B6B5E, section-hd #4A4A42, dim #3A3A32
         ═══════════════════════════════════════════════════════════════ -->
    <color name="text_cream">#F5F0E8</color>      <!-- primary text — warm white -->
    <color name="text_muted">#6B6B5E</color>      <!-- secondary / subtext -->
    <color name="text_dim">#4A4A42</color>        <!-- section headers -->
    <color name="text_ghost">#3A3A32</color>      <!-- very muted, bottom nav inactive -->

    <!-- Legacy aliases -->
    <color name="text_primary">@color/text_cream</color>
    <color name="text_secondary">@color/text_muted</color>

    <!-- ═══════════════════════════════════════════════════════════════
         SEMANTIC — kept minimal; gold replaces all color signal
         ═══════════════════════════════════════════════════════════════ -->
    <color name="status_success">@color/gold</color>
    <color name="status_success_bg">@color/bg_featured</color>
    <color name="status_error">#C0544A</color>    <!-- muted red, used sparingly -->
    <color name="status_error_bg">#1A0E0D</color>
    <color name="status_warning">@color/gold</color>
    <color name="status_warning_bg">@color/bg_featured</color>

    <!-- Legacy -->
    <color name="warning_bg">@color/status_warning_bg</color>
    <color name="warning_text">@color/status_error</color>

    <!-- ═══════════════════════════════════════════════════════════════
         MODE BADGES  — gold-tinted variants for Economy/Balanced/Comfort
         ═══════════════════════════════════════════════════════════════ -->
    <color name="mode_economy_bg">@color/bg_featured</color>
    <color name="mode_economy_text">@color/gold</color>
    <color name="mode_balanced_bg">@color/bg_featured</color>
    <color name="mode_balanced_text">@color/gold</color>
    <color name="mode_comfort_bg">@color/bg_featured</color>
    <color name="mode_comfort_text">@color/gold</color>

    <!-- ═══════════════════════════════════════════════════════════════
         MISC UI
         ═══════════════════════════════════════════════════════════════ -->
    <color name="route_blue">@color/gold</color>
    <color name="chip_inactive_bg">@color/bg_surface</color>
    <color name="chip_inactive_text">@color/text_muted</color>
    <color name="divider">@color/border_default</color>
    <color name="scrim">#CC0D0D0B</color>         <!-- 80% dark scrim -->

    <!-- Category dots — all gold-family to stay in palette -->
    <color name="category_culture">@color/gold</color>
    <color name="category_nature">@color/gold_dim</color>
    <color name="category_food">@color/gold</color>
    <color name="category_shopping">@color/gold_dim</color>
    <color name="category_sport">@color/gold</color>
    <color name="category_wellness">@color/gold_dim</color>

</resources>
