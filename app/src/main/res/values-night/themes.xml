<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.TravelPath" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Typography -->
        <item name="android:fontFamily">@font/plus_jakarta</item>
        <item name="fontFamily">@font/plus_jakarta</item>

        <!-- Main colors -->
        <item name="colorPrimary">@color/emerald_accent</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/emerald_primary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/black</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="android:windowBackground">@color/black</item>

        <!-- Status bar and navigation bar colors -->
        <item name="android:statusBarColor">@color/bg_main</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/bg_main</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
