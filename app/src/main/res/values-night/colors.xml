<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ═══════════════════════════════════════════════════════════════
         DARK MODE — Slate-based depth system
         Surfaces use Slate rather than pure black to avoid the harsh
         contrast that makes text harder to read in dim environments.
         ═══════════════════════════════════════════════════════════════ -->

    <!-- Surface system -->
    <color name="surface_0">#0F172A</color>            <!-- Slate 900 — deepest bg -->
    <color name="surface_1">#1E293B</color>            <!-- Slate 800 — card background -->
    <color name="surface_2">#334155</color>            <!-- Slate 700 — elevated cards -->
    <color name="surface_3">#475569</color>            <!-- Slate 600 — active/selected -->

    <color name="bg_main">@color/surface_0</color>
    <color name="bg_primary">@color/surface_0</color>
    <color name="card_bg">@color/surface_1</color>
    <color name="border_color">#334155</color>

    <!-- Brand — keep hue, increase lightness for dark bg readability -->
    <color name="brand_primary">#818CF8</color>        <!-- Indigo 400 -->
    <color name="brand_primary_dark">#6366F1</color>   <!-- Indigo 500 -->
    <color name="brand_primary_light">#C7D2FE</color>  <!-- Indigo 200 -->
    <color name="brand_accent">#22D3EE</color>         <!-- Cyan 400 -->
    <color name="brand_accent_light">#164E63</color>   <!-- Cyan 900 — chip bg in dark -->

    <color name="emerald_primary">@color/brand_primary</color>
    <color name="emerald_accent">@color/brand_accent</color>
    <color name="emerald_light">@color/brand_accent_light</color>

    <!-- Typography -->
    <color name="text_primary">#F1F5F9</color>         <!-- Slate 100 -->
    <color name="text_secondary">#94A3B8</color>       <!-- Slate 400 -->
    <color name="text_muted">#64748B</color>           <!-- Slate 500 -->
    <color name="text_on_primary">#FFFFFF</color>

    <!-- Semantic — same hue, adjusted value for dark bg -->
    <color name="status_success">#34D399</color>       <!-- Emerald 400 -->
    <color name="status_success_bg">#064E3B</color>    <!-- Emerald 900 -->
    <color name="status_warning">#FBBF24</color>       <!-- Amber 400 -->
    <color name="status_warning_bg">#78350F</color>    <!-- Amber 900 -->
    <color name="status_error">#F87171</color>         <!-- Red 400 -->
    <color name="status_error_bg">#7F1D1D</color>      <!-- Red 900 -->

    <color name="warning_bg">@color/status_warning_bg</color>
    <color name="warning_text">@color/status_error</color>

    <!-- Mode badges -->
    <color name="mode_economy_bg">#064E3B</color>
    <color name="mode_economy_text">#6EE7B7</color>
    <color name="mode_balanced_bg">#1E1B4B</color>
    <color name="mode_balanced_text">#A5B4FC</color>
    <color name="mode_comfort_bg">#78350F</color>
    <color name="mode_comfort_text">#FDE68A</color>

    <!-- Category dots -->
    <color name="category_culture">#818CF8</color>
    <color name="category_nature">#34D399</color>
    <color name="category_food">#FB923C</color>
    <color name="category_shopping">#F472B6</color>
    <color name="category_sport">#60A5FA</color>
    <color name="category_wellness">#A78BFA</color>

    <!-- UI -->
    <color name="chip_inactive_bg">#1E293B</color>
    <color name="chip_inactive_text">#94A3B8</color>
    <color name="divider">#334155</color>
    <color name="scrim">#99000000</color>

    <color name="gradient_start">#00000000</color>
    <color name="gradient_end">#CC000000</color>

</resources>
