<?xml version="1.0" encoding="utf-8"?>
<!--
    heart_pop.xml
    Animation "pop" du bouton Like dans RouteAdapter.
    Séquence : agrandir rapidement → rétrécir légèrement en dessous de 1 → revenir à 1.
    Durée totale : 300ms. Pivot au centre du bouton (50%, 50%).
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:fillAfter="false">

    <!-- Phase 1 : expansion rapide (0–150ms) -->
    <scale
        android:fromXScale="1.0"
        android:toXScale="1.35"
        android:fromYScale="1.0"
        android:toYScale="1.35"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="150"
        android:interpolator="@android:interpolator/overshoot" />

    <!-- Phase 2 : retour élastique (150–300ms) -->
    <scale
        android:fromXScale="1.35"
        android:toXScale="1.0"
        android:fromYScale="1.35"
        android:toYScale="1.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:startOffset="150"
        android:duration="150"
        android:interpolator="@android:interpolator/fast_out_slow_in" />

</set>
